# Copy to .env and fill in. .env is git-ignored.
APP_NAME=Legal Assistant
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5433/legal
# Set SECRET_KEY to a random value of at least 32 characters before saving provider credentials.
SECRET_KEY=
# A private registration code. Leave empty to close registration once accounts are created.
INVITE_CODE=
# Enable when serving the public API over HTTPS.
COOKIE_SECURE=false
# Use protected mode for client material. See docs/PRIVACY.md for migration and deployment.
DATA_MODE=development
DOCUMENT_ENCRYPTION_KEY=
# Optional. Set a bucket name and AWS SDK credentials to store encrypted file payloads in S3.
S3_BUCKET=
PRIVATE_MODEL_BASE_URL=
PRIVATE_MODEL_API_KEY=
# JSON array of HTTP origins allowed to call the API with a session cookie.
WEB_ORIGINS=["http://localhost:3000"]

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-haiku-5-5
MODEL_DRAFT=claude-haiku-5-5
MODEL_CHEAP=claude-haiku-5-5
MODEL_JUDGE=claude-haiku-5-5

# For Open WebUI, set LLM_PROVIDER=openai_compatible, then configure its OpenAI-compatible API.
# Open WebUI's API endpoint is /api/chat/completions, so use the base URL ending in /api.
OPENAI_BASE_URL=http://localhost:3000/api
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_JUDGE=gpt-4o-mini
# Set these for a metered provider; local Open WebUI models can remain zero.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

# Optional: OpenRouter key for the decision model that screens candidate articles.
DECISION_API_KEY=
DECISION_MODEL=typesafe/jev-1.13

# Optional public legal discovery for development. Protected mode uses only local indexes.
BRAVE_SEARCH_API_KEY=

# Optional OpenRouter model IDs for answer writing and its credit-budget fallback.
WRITE_ROUTE=
WRITE_FALLBACK_ROUTE=
