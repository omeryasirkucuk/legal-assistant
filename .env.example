# Copy to .env and fill in. .env is git-ignored.
APP_NAME=Legal Assistant
DATABASE_URL=postgresql+asyncpg://legal:legal@localhost:5433/legal
# Set SECRET_KEY to a random value of at least 32 characters before saving provider credentials.
SECRET_KEY=

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-haiku-5-5
MODEL_DRAFT=claude-haiku-5-5
MODEL_CHEAP=claude-haiku-5-5
MODEL_JUDGE=claude-haiku-5-5

# For Open WebUI, set LLM_PROVIDER=openai_compatible, then configure its OpenAI-compatible API.
# Open WebUI's API endpoint is /api/chat/completions, so use the base URL ending in /api.
OPENAI_BASE_URL=http://localhost:3000/api
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=gpt-4o-mini
OPENAI_MODEL_DRAFT=gpt-4o-mini
OPENAI_MODEL_CHEAP=gpt-4o-mini
OPENAI_MODEL_JUDGE=gpt-4o-mini
# Set these when using a paid provider; local Open WebUI models can remain zero.
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0

NEXT_PUBLIC_API_URL=http://localhost:8000
